# Wood Events Service environment example

# Broker service
BROKER_HOST=0.0.0.0
BROKER_PORT=8000

# Notify service
NOTIFY_HOST=0.0.0.0
NOTIFY_PORT=8000

# ntfy adapter
# Use the bundled Compose service by default, or point this at an external ntfy
# base URL without code changes.
NTFY_BASE_URL=http://ntfy:80

# External shared infrastructure
# PostgreSQL may be provided externally. Add connection settings in the story
# that implements persistence; do not commit credentials.
# WOOD_EVENTS_DATABASE_URL=
