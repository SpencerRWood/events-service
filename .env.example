# Wood Events Service environment example

# Broker service
BROKER_HOST=0.0.0.0
BROKER_PORT=8000
# Broker persistence uses centralized PostgreSQL. Keep the value in local secret
# management or deployment configuration; do not commit credentials.
BROKER_DATABASE_URL=
BROKER_DELIVERY_TIMEOUT_SECONDS=5
BROKER_MAX_DELIVERY_ATTEMPTS=3
BROKER_RETRY_BACKOFF_SECONDS=30

# Notify service
NOTIFY_HOST=0.0.0.0
NOTIFY_PORT=8000
NOTIFY_DATABASE_URL=
NOTIFY_DELIVERY_TIMEOUT_SECONDS=5
NOTIFY_MAX_DELIVERY_ATTEMPTS=3
NOTIFY_RETRY_BACKOFF_SECONDS=30

# Optional notification provider credentials belong in secret management or
# deployment configuration, never in the repository.
NOTIFY_TELEGRAM_BASE_URL=https://api.telegram.org
NOTIFY_TELEGRAM_BOT_TOKEN=
NOTIFY_TELEGRAM_CHAT_ID=
NOTIFY_SMTP_HOST=
NOTIFY_SMTP_PORT=587
NOTIFY_SMTP_USERNAME=
NOTIFY_SMTP_PASSWORD=
NOTIFY_SMTP_FROM_ADDRESS=
NOTIFY_SMTP_TO_ADDRESS=

# ntfy adapter
# Use the bundled Compose service by default, or point this at an external ntfy
# base URL without code changes.
NTFY_BASE_URL=http://ntfy:80

# External shared infrastructure
# Centralized PostgreSQL is external shared infrastructure and is not bundled in
# this Compose stack.
# WOOD_EVENTS_DATABASE_URL=
